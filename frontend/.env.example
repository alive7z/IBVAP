# IBVAP frontend configuration
# Copy to .env and adjust to your environment. Values shown are dev defaults.

# Base URL of the Node.js + Express REST API (includes the /api prefix).
# The backend runs on port 5001 (backend/.env PORT=5001).
VITE_API_BASE_URL=http://localhost:5001/api

# WebSocket / Socket.IO URL (unused until Phase 6 real-time integration).
VITE_WS_URL=http://localhost:5001
