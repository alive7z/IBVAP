{
  "name": "ibvap-backend",
  "version": "0.1.0",
  "description": "IBVAP – Intelligent Border Video Analytics Platform (Node.js backend foundation)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
